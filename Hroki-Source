<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>HROKI</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200'%3E%3Cg stroke='%23de860a' stroke-width='9' fill='none' stroke-linecap='round'%3E%3Cline x1='6' y1='51.6' x2='193.6' y2='51.6'/%3E%3Cline x1='6' y1='148.2' x2='193.6' y2='148.2'/%3E%3Cline x1='28.5' y1='30.4' x2='28.5' y2='169.4'/%3E%3Cline x1='171.1' y1='30.4' x2='171.1' y2='169.4'/%3E%3Cline x1='99.8' y1='7.2' x2='99.8' y2='192.6'/%3E%3Cline x1='73.6' y1='23.3' x2='126' y2='23.3'/%3E%3Cline x1='73.6' y1='176.5' x2='126' y2='176.5'/%3E%3C/g%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0a0a;
    --panel: #0f0f0f;
    --accent: #de860a;
    --accent-dim: #7a4a08;
    --accent-faint: #3a2205;
    --accent-bright: #ffb020;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--accent);
    font-family: "Courier New", Courier, monospace;
    min-height: 100vh;
    text-shadow: 0 0 4px rgba(222, 134, 10, 0.55);
  }

  body {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 28px 14px;
  }

  .console {
    width: 100%;
    max-width: 760px;
    border: 2px solid var(--accent);
    padding: 2px;
    box-shadow: 0 0 10px rgba(222, 134, 10, 0.4);
  }

  .console-inner {
    border: 1px solid var(--accent-dim);
    padding: 18px 20px 20px;
    box-shadow: 0 0 6px rgba(222, 134, 10, 0.2) inset;
  }

  /* ---------- Header ---------- */
  .header {
    border-bottom: 2px solid var(--accent);
    padding-bottom: 26px;
    margin-bottom: 16px;
    display: flex;
    justify-content: center;
  }

  .header-title {
    text-align: center;
  }

  .title {
    font-family: 'VT323', 'Courier New', Courier, monospace;
    font-size: 46px;
    font-weight: normal;
    letter-spacing: 12px;
    margin: 0;
    line-height: 1;
  }

  .subtitle-swap {
    position: relative;
    display: inline-block;
    min-width: 100px;
    min-height: 22px;
    margin: 6px auto 0;
    transition: min-height 0.4s ease;
  }

  .subtitle-swap.expanded {
    min-height: 66px;
  }

  .subtitle {
    position: static;
    font-size: 13px;
    letter-spacing: 2px;
    color: #c81e1e;
    font-style: italic;
    text-shadow: 0 0 4px rgba(200, 30, 30, 0.6);
    white-space: nowrap;
    cursor: pointer;
    transition: opacity 0.6s ease;
  }

  .wave-letter {
    display: inline-block;
    animation: letter-wave 1.3s ease-in-out infinite;
  }

  @keyframes letter-wave {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-4px) rotate(-6deg); }
  }

  .subtitle.fading {
    opacity: 0;
  }

  .subtitle-logo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 52px;
    height: 52px;
    margin: -26px 0 0 -26px;
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }

  .subtitle-logo.visible {
    opacity: 1;
    pointer-events: auto;
    cursor: pointer;
  }

  .subtitle-logo svg {
    width: 100%;
    height: 100%;
    display: block;
    filter: drop-shadow(0 0 4px rgba(200, 30, 30, 0.6));
  }

  /* ---------- Section blocks ---------- */
  .block {
    border: 1px solid var(--accent-dim);
    margin-bottom: 14px;
    box-shadow: 0 0 6px rgba(222, 134, 10, 0.18);
  }

  .block-label {
    font-size: 11px;
    letter-spacing: 3px;
    padding: 6px 10px;
    border-bottom: 1px solid var(--accent-dim);
    display: flex;
    justify-content: space-between;
  }

  .block-body {
    padding: 12px;
  }

  /* ---------- File intake ---------- */
  .intake-row {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }

  input[type="file"] {
    display: none;
  }

  .btn {
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--accent);
    font-family: inherit;
    font-size: 12px;
    letter-spacing: 2px;
    padding: 9px 16px;
    cursor: pointer;
    box-shadow: 0 0 5px rgba(222, 134, 10, 0.35);
  }

  .btn:hover {
    background: var(--accent);
    color: var(--bg);
    box-shadow: 0 0 10px rgba(222, 134, 10, 0.6);
  }

  .btn:disabled {
    color: var(--accent-dim);
    border-color: var(--accent-dim);
    cursor: default;
  }

  .btn:disabled:hover {
    background: transparent;
    color: var(--accent-dim);
  }

  .btn-primary {
    border-width: 2px;
  }

  .file-count {
    font-size: 11px;
    color: var(--accent-dim);
  }

  /* ---------- Loaded file list ---------- */
  .file-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
    table-layout: fixed;
  }

  .file-table th {
    text-align: left;
    font-weight: normal;
    letter-spacing: 1px;
    color: var(--accent-dim);
    border-bottom: 1px solid var(--accent-dim);
    border-right: 1px solid var(--accent-faint);
    padding: 4px 6px;
  }

  .file-table th:last-child,
  .file-table td:last-child {
    border-right: none;
  }

  .file-table td {
    padding: 4px 6px;
    border-bottom: 1px solid var(--accent-faint);
    border-right: 1px solid var(--accent-faint);
    vertical-align: top;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .file-table th:nth-child(1),
  .file-table td:nth-child(1) {
    width: 19%;
  }

  .file-table th:nth-child(2),
  .file-table td:nth-child(2) {
    width: 15%;
  }

  .file-table th:nth-child(3),
  .file-table td:nth-child(3) {
    width: 14%;
  }

  .file-table th:nth-child(4),
  .file-table td:nth-child(4) {
    width: 44%;
  }

  .file-table th:nth-child(5),
  .file-table td:nth-child(5) {
    width: 8%;
  }

  .file-table tr.row-error td {
    color: var(--accent-dim);
    font-style: italic;
  }

  .empty-row {
    color: var(--accent-dim);
    font-size: 12px;
    padding: 4px 6px;
  }

  .remove-x {
    cursor: pointer;
    color: var(--accent-dim);
  }
  .remove-x:hover {
    color: var(--accent-bright);
  }

  .attr-toggles {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .attr-toggle {
    background: transparent;
    color: var(--accent-dim);
    border: 1px solid var(--accent-dim);
    font-family: inherit;
    font-size: 10px;
    letter-spacing: 1px;
    padding: 3px 6px;
    cursor: pointer;
  }

  .attr-toggle.active {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
    box-shadow: 0 0 6px rgba(222, 134, 10, 0.6);
  }

  .attr-cell {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .attr-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .attr-group + .attr-group {
    border-top: 1px solid var(--accent-faint);
    padding-top: 8px;
  }

  .attr-group-label {
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--accent-dim);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .custom-add-btn {
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--accent-dim);
    font-family: inherit;
    font-size: 11px;
    line-height: 1;
    padding: 1px 6px;
    cursor: pointer;
  }

  .custom-add-btn:hover {
    background: var(--accent);
    color: var(--bg);
    box-shadow: 0 0 6px rgba(222, 134, 10, 0.6);
  }

  .custom-fields {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .custom-field-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .custom-input {
    background: var(--bg);
    border: 1px solid var(--accent-dim);
    color: var(--accent);
    font-family: inherit;
    font-size: 11px;
    padding: 4px 6px;
    box-shadow: 0 0 4px rgba(222, 134, 10, 0.2);
    flex: 1;
    min-width: 120px;
  }

  .custom-input:focus {
    outline: 1px solid var(--accent);
  }

  .custom-remove {
    cursor: pointer;
    color: var(--accent-dim);
    font-size: 14px;
    line-height: 1;
    padding: 0 2px;
  }

  .custom-remove:hover {
    color: var(--accent-bright);
  }

  .custom-warning {
    font-size: 10px;
    letter-spacing: 0.5px;
    color: #c81e1e;
    font-style: italic;
    line-height: 1.4;
    text-shadow: 0 0 4px rgba(200, 30, 30, 0.6);
  }

  .warn-symbol {
    display: inline-block;
    color: #e6c229;
    text-shadow: 0 0 4px rgba(230, 194, 41, 0.6);
    cursor: pointer;
    font-size: 13px;
    line-height: 1;
    width: fit-content;
  }

  .warn-symbol:hover {
    color: #f5d84a;
  }

  .steamid-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-style: dotted;
    cursor: pointer;
  }

  .steamid-link:hover {
    color: var(--accent-bright);
  }

  /* ---------- Log ---------- */
  .log {
    height: 170px;
    overflow-y: auto;
    overflow-x: auto;
    font-size: 12px;
    line-height: 1.6;
    white-space: pre;
    box-shadow: 0 0 6px rgba(222, 134, 10, 0.15) inset;
  }

  .log-line {
    white-space: pre;
  }

  .log-line::before {
    content: "> ";
    color: var(--accent-dim);
  }

  .log-dim {
    color: var(--accent-dim);
    text-shadow: 0 0 3px rgba(122, 74, 8, 0.4);
  }

  .cursor {
    display: inline-block;
    width: 8px;
    background: var(--accent);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  /* ---------- Output row ---------- */
  .output-row {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }

  .output-row input[type="text"] {
    background: var(--bg);
    border: 1px solid var(--accent-dim);
    color: var(--accent);
    font-family: inherit;
    font-size: 12px;
    padding: 9px 10px;
    flex: 1;
    min-width: 160px;
    box-shadow: 0 0 4px rgba(222, 134, 10, 0.2);
  }

  .output-row input[type="text"]:focus {
    outline: 1px solid var(--accent);
  }

  .summary-line {
    font-size: 12px;
    margin-top: 10px;
    color: var(--accent-dim);
  }

  .summary-line strong {
    color: var(--accent);
    font-weight: normal;
  }

  .error-text {
    color: #c81e1e;
    text-shadow: 0 0 4px rgba(200, 30, 30, 0.6);
  }

  /* ---------- Footer ---------- */
  .credit-console {
    width: 100%;
    max-width: 760px;
    border: 2px solid var(--accent);
    padding: 2px;
    margin-top: 14px;
    box-shadow: 0 0 8px rgba(222, 134, 10, 0.3);
  }

  .credit-console-inner {
    border: 1px solid var(--accent-dim);
    padding: 8px 20px;
    text-align: center;
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--accent-dim);
    font-style: italic;
  }

  ::-webkit-scrollbar { width: 8px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--accent-dim); }
</style>
</head>
<body>

<div class="console">
  <div class="console-inner">

    <div class="header">
      <div class="header-title">
        <p class="title">HROKI</p>
        <div class="subtitle-swap" id="subtitleSwap">
          <p class="subtitle" id="subtitleText">Pride kills.</p>
          <div class="subtitle-logo" id="subtitleLogo">
            <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <g stroke="#c81e1e" stroke-width="9" fill="none" stroke-linecap="round">
                <line x1="6" y1="51.6" x2="193.6" y2="51.6"/>
                <line x1="6" y1="148.2" x2="193.6" y2="148.2"/>
                <line x1="28.5" y1="30.4" x2="28.5" y2="169.4"/>
                <line x1="171.1" y1="30.4" x2="171.1" y2="169.4"/>
                <line x1="99.8" y1="7.2" x2="99.8" y2="192.6"/>
                <line x1="73.6" y1="23.3" x2="126" y2="23.3"/>
                <line x1="73.6" y1="176.5" x2="126" y2="176.5"/>
              </g>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <div class="block">
      <div class="block-label"><span>FILE INTAKE</span><span id="fileCountLabel">0 LOADED</span></div>
      <div class="block-body">
        <div class="intake-row">
          <input type="file" id="fileInput" accept=".json,application/json" multiple>
          <button class="btn" id="loadBtn">SELECT FILES</button>
          <button class="btn" id="clearBtn">CLEAR ALL</button>
          <span class="file-count" id="fileCountText">no files in tray</span>
        </div>
      </div>
    </div>

    <div class="block">
      <div class="block-label"><span>LOADED SOURCES</span><span>STEAMID COUNT</span></div>
      <div class="block-body">
        <table class="file-table" id="fileTable">
          <thead>
            <tr><th>FILE</th><th>STEAMIDS</th><th>STATUS</th><th>ATTRIBUTE</th><th></th></tr>
          </thead>
          <tbody id="fileTableBody">
            <tr><td colspan="5" class="empty-row">-- no sources loaded --</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="block">
      <div class="block-label"><span>CONSOLE LOG</span></div>
      <div class="block-body">
        <div class="log" id="log"></div>
      </div>
    </div>

    <div class="block">
      <div class="block-label"><span><span id="mergeLabelEgg">MERGE</span> / EXPORT</span></div>
      <div class="block-body">
        <div class="output-row">
          <input type="text" id="outName" value="HrokiList" spellcheck="false">
          <span class="file-count" id="jsonEgg" style="cursor: pointer;">.json</span>
          <button class="btn btn-primary" id="mergeBtn" disabled>MERGE LOADED FILES</button>
          <button class="btn" id="downloadBtn" disabled>EXPORT OUTPUT</button>
        </div>
        <div class="summary-line" id="summaryLine">awaiting merge — load files to begin</div>
      </div>
    </div>

  </div>
</div>

<div class="credit-console">
  <div class="credit-console-inner">Vibecoded by <span id="bekymreEgg">Bekymre</span>.</div>
</div>

<audio id="jsonEggAudio" preload="none" src="data:audio/mpeg;base64,"></audio>
<script>
(function () {
  const fileInput = document.getElementById('fileInput');
  const loadBtn = document.getElementById('loadBtn');
  const clearBtn = document.getElementById('clearBtn');
  const fileTableBody = document.getElementById('fileTableBody');
  const fileCountLabel = document.getElementById('fileCountLabel');
  const fileCountText = document.getElementById('fileCountText');
  const logEl = document.getElementById('log');
  const mergeBtn = document.getElementById('mergeBtn');
  const downloadBtn = document.getElementById('downloadBtn');
  const outName = document.getElementById('outName');
  const summaryLine = document.getElementById('summaryLine');
  const subtitleText = document.getElementById('subtitleText');
  const subtitleLogo = document.getElementById('subtitleLogo');
  const subtitleSwap = document.getElementById('subtitleSwap');

  if (subtitleText) {
    // Wrap each character in its own span so letter-wave can stagger them
    // into a traveling wave, like the Hotline Miami title screen.
    const rawText = subtitleText.textContent;
    subtitleText.textContent = '';
    rawText.split('').forEach((ch, i) => {
      const span = document.createElement('span');
      span.className = 'wave-letter';
      span.style.animationDelay = (i * 0.07) + 's';
      span.textContent = ch === ' ' ? '\u00A0' : ch;
      subtitleText.appendChild(span);
    });

    subtitleText.addEventListener('click', () => {
      if (subtitleText.classList.contains('fading')) return;
      subtitleText.classList.add('fading');
      if (subtitleSwap) subtitleSwap.classList.add('expanded');
      setTimeout(() => {
        subtitleText.style.display = 'none';
        subtitleLogo.classList.add('visible');
      }, 600);
    });

    subtitleLogo.addEventListener('click', () => {
      if (!subtitleLogo.classList.contains('visible')) return;
      subtitleLogo.classList.remove('visible');
      if (subtitleSwap) subtitleSwap.classList.remove('expanded');
      setTimeout(() => {
        subtitleText.style.display = '';
        void subtitleText.offsetWidth; // force reflow so the fade-in transition runs
        subtitleText.classList.remove('fading');
      }, 600);
    });

    // Continuous, never-stopping motion for the symbol: rotation is driven
    // by a running phase, and the swing amplitude is re-randomized every
    // time it crosses center, so each swing is a different, unequal size.
    // Bounce runs on its own unsynced phase, moving both up and down with
    // its own randomized amplitude per swing, kept within a range that
    // fits inside the expanded header space without clipping.
    const symbolSvg = subtitleLogo.querySelector('svg');
    if (symbolSvg) {
      const randomBetween = (min, max) => min + Math.random() * (max - min);
      let phase = 0;
      let bouncePhase = Math.random() * Math.PI;
      let rotateAmp = randomBetween(15, 32);
      let bounceAmp = randomBetween(4, 12);
      let lastSign = 1;
      let lastBounceSign = 1;
      let lastTime = null;
      const angularSpeed = 0.85; // radians/sec — a bit brisker than before
      const bounceSpeed = 0.7;

      function stepSymbol(now) {
        if (lastTime === null) lastTime = now;
        const dt = (now - lastTime) / 1000;
        lastTime = now;

        phase += dt * angularSpeed;
        bouncePhase += dt * bounceSpeed;

        const rotation = rotateAmp * Math.sin(phase);
        const sign = Math.sin(phase) >= 0 ? 1 : -1;
        if (sign !== lastSign) {
          // Crossed center — pick a new, unequal amplitude for the next swing.
          rotateAmp = randomBetween(15, 32);
          lastSign = sign;
        }

        const bounceWave = Math.sin(bouncePhase);
        const bounceSign = bounceWave >= 0 ? 1 : -1;
        if (bounceSign !== lastBounceSign) {
          // Crossed center — pick a new, unequal up/down amount, kept modest
          // enough to stay comfortably inside the expanded header area.
          bounceAmp = randomBetween(4, 12);
          lastBounceSign = bounceSign;
        }
        const bounce = bounceWave * bounceAmp;

        symbolSvg.style.transform = 'translateY(' + bounce.toFixed(2) + 'px) rotate(' + rotation.toFixed(2) + 'deg)';
        requestAnimationFrame(stepSymbol);
      }
      requestAnimationFrame(stepSymbol);
    }
  }

  const bekymreEgg = document.getElementById('bekymreEgg');
  if (bekymreEgg) {
    bekymreEgg.addEventListener('click', () => {
      window.open('https://youtu.be/eTP6GGac1n8', '_blank', 'noopener,noreferrer');
      bekymreEgg.textContent = 'bunnies';
    });
  }

  const jsonEgg = document.getElementById('jsonEgg');
  const jsonEggAudio = document.getElementById('jsonEggAudio');
  if (jsonEgg && jsonEggAudio) {
    jsonEggAudio.volume = 0.25; // kept low so it doesn't blast anyone
    jsonEgg.addEventListener('click', () => {
      jsonEggAudio.currentTime = 0;
      jsonEggAudio.play().catch(() => {});
    });
  }

  const mergeLabelEgg = document.getElementById('mergeLabelEgg');
  if (mergeLabelEgg) {
    mergeLabelEgg.addEventListener('click', () => {
      window.open('https://www.youtube.com/watch?v=VvVThrMhnuE', '_blank', 'noopener,noreferrer');
    });
  }

  let sources = []; // { id, name, ok, entries, data, error, noChanges, suspicious, extraAttrs: [] }
  let mergedResult = null;
  let nextId = 1;
  const ATTRIBUTE_OPTIONS = ['Cheater', 'POI', 'Degen', 'Furry', 'Toxic'];

  function log(msg, variant) {
    const line = document.createElement('div');
    let cls = 'log-line';
    if (variant === true || variant === 'error') cls += ' error-text';
    else if (variant === 'dim') cls += ' log-dim';
    line.className = cls;
    line.textContent = msg;
    logEl.appendChild(line);
    logEl.scrollTop = logEl.scrollHeight;
  }

  // Same as log(), but the message is inserted as HTML rather than plain
  // text — used only for lines built with buildSteamIdLink(), where the
  // steamid text itself is escaped and the href is built from digits only.
  function logHtml(html, variant) {
    const line = document.createElement('div');
    let cls = 'log-line';
    if (variant === true || variant === 'error') cls += ' error-text';
    else if (variant === 'dim') cls += ' log-dim';
    line.className = cls;
    line.innerHTML = html;
    logEl.appendChild(line);
    logEl.scrollTop = logEl.scrollHeight;
  }

  // Converts a SteamID32 in "[U:1:accountId]" form into a clickable
  // SteamHistory link (SteamID64 = accountId + 76561197960265728). Falls
  // back to plain escaped text if the format doesn't match.
  function buildSteamIdLink(steamid) {
    const match = /\[U:1:(\d+)\]/.exec(steamid);
    if (!match) return escapeHtml(steamid);
    const id64 = BigInt(match[1]) + 76561197960265728n;
    const url = 'https://steamhistory.net/id/' + id64.toString();
    return '<a href="' + url + '" target="_blank" rel="noopener noreferrer" class="steamid-link">' +
      escapeHtml(steamid) + '</a>';
  }

  log('HROKI TERMINAL READY.');
  log('AWAITING FILE INTAKE...');

  loadBtn.addEventListener('click', () => fileInput.click());

  fileInput.addEventListener('change', (e) => {
    const files = Array.from(e.target.files || []);
    if (!files.length) return;

    let pending = files.length;
    files.forEach(file => {
      const reader = new FileReader();
      reader.onload = () => {
        processFile(file.name, reader.result);
        pending -= 1;
        if (pending === 0) finishIntake();
      };
      reader.onerror = () => {
        sources.push({ id: nextId++, name: file.name, ok: false, entries: 0, error: 'READ FAILURE' });
        log('ERROR: could not read ' + file.name);
        pending -= 1;
        if (pending === 0) finishIntake();
      };
      reader.readAsText(file);
    });

    fileInput.value = '';
  });

  function processFile(name, text) {
    let json;
    try {
      json = JSON.parse(text);
    } catch (err) {
      sources.push({ id: nextId++, name, ok: false, entries: 0, error: 'INVALID JSON' });
      log('ERROR: ' + name + ' is not valid JSON');
      return;
    }
    if (!json || !Array.isArray(json.players)) {
      sources.push({ id: nextId++, name, ok: false, entries: 0, error: 'NO PLAYERS ARRAY' });
      log('ERROR: ' + name + ' missing "players" array');
      return;
    }
    const validPlayers = json.players.filter(p => p && typeof p.steamid === 'string');
    if (validPlayers.length === 0) {
      sources.push({ id: nextId++, name, ok: false, entries: 0, error: 'INVALID JSON — NO STEAMIDS PRESENT', noSteamIds: true });
      log('ERROR: ' + name + ' contains no SteamIDs');
      return;
    }

    // If this file is itself a previous HROKI export, it already carries
    // the full list of group names archived into it — inherit that whole
    // history instead of treating the export as a single new group.
    const info = json.file_info || {};
    let archivedGroups;
    if (Array.isArray(info.hroki_archived_groups) && info.hroki_archived_groups.length) {
      archivedGroups = info.hroki_archived_groups.slice();
    } else {
      archivedGroups = [info.title || name];
    }

    sources.push({
      id: nextId++, name, ok: true, entries: validPlayers.length, data: json,
      noChanges: true, suspicious: true, extraAttrs: [], customValues: [], showSuspiciousInfo: false, archivedGroups
    });
    log('LOADED ' + name + ' :: ' + validPlayers.length + ' SteamIDs');
  }

  function finishIntake() {
    renderTable();
    mergeBtn.disabled = sources.filter(s => s.ok).length === 0;
  }

  function renderTable() {
    fileCountLabel.textContent = sources.length + ' LOADED';
    fileCountText.textContent = sources.length
      ? sources.length + ' file(s) in tray'
      : 'no files in tray';

    if (!sources.length) {
      fileTableBody.innerHTML = '<tr><td colspan="5" class="empty-row">-- no sources loaded --</td></tr>';
      return;
    }

    const display = sources.slice().sort((a, b) => (b.entries || 0) - (a.entries || 0));

    fileTableBody.innerHTML = '';
    display.forEach(s => {
      const tr = document.createElement('tr');
      if (!s.ok) tr.classList.add('row-error');

      const attrCell = s.ok
        ? '<div class="attr-cell">' +
          '<div class="attr-group">' +
          '<div class="attr-group-label">PRESET</div>' +
          (s.suspicious
            ? '<span class="warn-symbol" data-id="' + s.id + '" title="What does this mean?">⚠</span>' +
              (s.showSuspiciousInfo
                ? '<div class="custom-warning">⚠ Deselecting Suspicious drops that mark if another is selected — keep Suspicious selected to retain it.</div>'
                : '')
            : '') +
          '<div class="attr-toggles">' +
          '<button type="button" class="attr-toggle' + (s.noChanges ? ' active' : '') +
            '" data-id="' + s.id + '" data-role="nochanges">No changes</button>' +
          '<button type="button" class="attr-toggle' + (s.suspicious ? ' active' : '') +
            '" data-id="' + s.id + '" data-role="suspicious">Suspicious</button>' +
          ATTRIBUTE_OPTIONS.map(opt => {
            const val = opt.toLowerCase();
            const active = s.extraAttrs.includes(val);
            return '<button type="button" class="attr-toggle' + (active ? ' active' : '') +
              '" data-id="' + s.id + '" data-role="extra" data-attr="' + val + '">' + opt + '</button>';
          }).join('') +
          '</div>' +
          '</div>' +
          '<div class="attr-group custom-group">' +
          '<div class="attr-group-label">CUSTOM' +
          '<button type="button" class="custom-add-btn" data-id="' + s.id + '" title="Add custom tag">+</button>' +
          '</div>' +
          (s.customValues && s.customValues.length
            ? '<div class="custom-warning">⚠ Case and spelling sensitive.</div>' +
              '<div class="custom-fields">' +
              s.customValues.map((val, idx) =>
                '<div class="custom-field-row">' +
                '<input type="text" class="custom-input" data-id="' + s.id + '" data-idx="' + idx +
                '" value="' + escapeHtml(val || '') + '" placeholder="Exact custom mark text" spellcheck="false">' +
                '<span class="custom-remove" data-id="' + s.id + '" data-idx="' + idx + '" title="Remove">×</span>' +
                '</div>'
              ).join('') +
              '</div>'
            : '') +
          '</div>' +
          '</div>'
        : '--';

      tr.innerHTML =
        '<td>' + escapeHtml(s.name) + '</td>' +
        '<td>' + (s.ok ? s.entries : '--') + '</td>' +
        '<td>' + (s.ok ? 'OK' : s.error) + '</td>' +
        '<td>' + attrCell + '</td>' +
        '<td class="remove-x" data-id="' + s.id + '">[X]</td>';
      fileTableBody.appendChild(tr);
    });

    fileTableBody.querySelectorAll('.attr-toggle').forEach(el => {
      el.addEventListener('click', () => {
        const id = parseInt(el.getAttribute('data-id'), 10);
        const role = el.getAttribute('data-role');
        const s = sources.find(s => s.id === id);
        if (!s) return;

        if (role === 'nochanges') {
          if (!s.noChanges) {
            // Turning "No changes" on means the file is left completely
            // untouched at merge time — clear any extra attributes and
            // custom marks that were selected. Suspicious is left as-is
            // internally but is not shown as selected while "No changes"
            // is active, since nothing is actually being applied.
            s.noChanges = true;
            s.extraAttrs = [];
            s.customValues = [];
          } else {
            s.noChanges = false;
          }
        } else if (role === 'suspicious') {
          s.suspicious = !s.suspicious;
        } else if (role === 'extra') {
          const attr = el.getAttribute('data-attr');
          const idx = s.extraAttrs.indexOf(attr);
          if (idx === -1) {
            s.extraAttrs.push(attr);
            s.noChanges = false;
          } else {
            s.extraAttrs.splice(idx, 1);
          }
        }

        renderTable();
        downloadBtn.disabled = true;
        mergedResult = null;
        summaryLine.textContent = 'source list changed — re-run merge';
      });
    });

    fileTableBody.querySelectorAll('.custom-add-btn').forEach(el => {
      el.addEventListener('click', () => {
        const id = parseInt(el.getAttribute('data-id'), 10);
        const s = sources.find(s => s.id === id);
        if (!s) return;
        if (!Array.isArray(s.customValues)) s.customValues = [];
        s.customValues.push('');
        s.noChanges = false;
        renderTable();
        downloadBtn.disabled = true;
        mergedResult = null;
        summaryLine.textContent = 'source list changed — re-run merge';
      });
    });

    fileTableBody.querySelectorAll('.custom-remove').forEach(el => {
      el.addEventListener('click', () => {
        const id = parseInt(el.getAttribute('data-id'), 10);
        const idx = parseInt(el.getAttribute('data-idx'), 10);
        const s = sources.find(s => s.id === id);
        if (!s || !Array.isArray(s.customValues)) return;
        s.customValues.splice(idx, 1);
        renderTable();
        downloadBtn.disabled = true;
        mergedResult = null;
        summaryLine.textContent = 'source list changed — re-run merge';
      });
    });

    fileTableBody.querySelectorAll('.custom-input').forEach(el => {
      el.addEventListener('input', () => {
        const id = parseInt(el.getAttribute('data-id'), 10);
        const idx = parseInt(el.getAttribute('data-idx'), 10);
        const s = sources.find(s => s.id === id);
        if (!s || !Array.isArray(s.customValues)) return;
        s.customValues[idx] = el.value;
        downloadBtn.disabled = true;
        mergedResult = null;
        summaryLine.textContent = 'source list changed — re-run merge';
      });
    });

    fileTableBody.querySelectorAll('.warn-symbol').forEach(el => {
      el.addEventListener('click', () => {
        const id = parseInt(el.getAttribute('data-id'), 10);
        const s = sources.find(s => s.id === id);
        if (!s) return;
        s.showSuspiciousInfo = !s.showSuspiciousInfo;
        renderTable();
      });
    });

    fileTableBody.querySelectorAll('.remove-x').forEach(el => {
      el.addEventListener('click', () => {
        const id = parseInt(el.getAttribute('data-id'), 10);
        const i = sources.findIndex(s => s.id === id);
        if (i === -1) return;
        log('REMOVED ' + sources[i].name + ' FROM TRAY');
        sources.splice(i, 1);
        renderTable();
        mergeBtn.disabled = sources.filter(s => s.ok).length === 0;
        downloadBtn.disabled = true;
        mergedResult = null;
        summaryLine.textContent = 'source list changed — re-run merge';
      });
    });
  }

  clearBtn.addEventListener('click', () => {
    sources = [];
    mergedResult = null;
    renderTable();
    mergeBtn.disabled = true;
    downloadBtn.disabled = true;
    summaryLine.textContent = 'awaiting merge — load files to begin';
    log('TRAY CLEARED.');
  });

  mergeBtn.addEventListener('click', () => {
    // Files with no SteamIDs at all can never be merged — flag every one
    // of them and block export outright, regardless of any other file's
    // state.
    const noSteamIdSources = sources.filter(s => s.noSteamIds);
    if (noSteamIdSources.length) {
      log('--------------------------------');
      noSteamIdSources.forEach(s => {
        log('ERROR: No SteamIDs present in ' + s.name, true);
      });
      summaryLine.innerHTML = noSteamIdSources
        .map(s => '<span class="error-text">No SteamIDs present in ' + escapeHtml(s.name) + '.</span>')
        .join('<br>');
      downloadBtn.disabled = true;
      mergedResult = null;
      return;
    }

    const valid = sources.filter(s => s.ok);
    if (!valid.length) return;

    // Every file must end up with at least one attribute on its entries.
    // "No changes" is always valid on its own — it leaves the file exactly
    // as it was, so it never needs this check. Otherwise it fails only
    // when "Suspicious" is off and no extra or custom attributes are
    // selected.
    const emptyAttrSources = valid.filter(s => {
      if (s.noChanges) return false;
      const hasCustom = Array.isArray(s.customValues) && s.customValues.some(v => v && v.trim().length > 0);
      return !s.suspicious && (!s.extraAttrs || s.extraAttrs.length === 0) && !hasCustom;
    });
    if (emptyAttrSources.length) {
      log('--------------------------------');
      emptyAttrSources.forEach(s => {
        log('ERROR: At least 1 attribute must be selected for ' + s.name, true);
      });
      summaryLine.innerHTML = emptyAttrSources
        .map(s => '<span class="error-text">At least 1 attribute must be selected for ' + escapeHtml(s.name) + '.</span>')
        .join('<br>');
      downloadBtn.disabled = true;
      mergedResult = null;
      return;
    }

    log('--------------------------------');

    // Apply each source's attribute selections. "No changes" means exactly
    // that — the file's original attributes pass through untouched, no
    // matter what the Suspicious/extra/custom toggles happen to hold.
    // Otherwise: if "Suspicious" was deselected, strip "suspicious" from
    // every player's attribute list; then append any selected extra
    // attributes (e.g. cheater, toxic) and any custom mark, alongside
    // whatever remains. Duplicates are not added twice. Unlike the fixed
    // options, the custom mark is never lowercased — it's used exactly as
    // the user typed it.
    function applyAttributeChanges(source, attrs) {
      if (source.noChanges) return attrs;
      let result = attrs;
      if (!source.suspicious) {
        result = result.filter(a => a !== 'suspicious');
      }
      const extras = (source.extraAttrs || []).slice();
      if (Array.isArray(source.customValues)) {
        source.customValues.forEach(v => {
          if (v && v.trim()) extras.push(v.trim());
        });
      }
      if (extras.length) {
        result = result.slice();
        extras.forEach(extra => {
          if (!result.includes(extra)) result.push(extra);
        });
      }
      return result;
    }

    // PHASE 1: scan every source and record every steamid seen, with its
    // attributes, before any merging happens. This is the reference set
    // used later to confirm nothing was dropped.
    log('SCANNING SOURCES FOR STEAMIDS...');
    const scanned = new Map(); // steamid -> Set of attributes (union across all sources)
    valid.forEach(s => {
      s.data.players.forEach(p => {
        if (!p || typeof p.steamid !== 'string') return;
        const attrs = applyAttributeChanges(s, Array.isArray(p.attributes) ? p.attributes : []);
        if (!scanned.has(p.steamid)) scanned.set(p.steamid, new Set());
        attrs.forEach(a => scanned.get(p.steamid).add(a));
      });
    });
    log('SCAN COMPLETE: ' + scanned.size + ' unique steamID(s) across ' + valid.length + ' source(s)');

    log('INITIATING MERGE OF ' + valid.length + ' SOURCE(S)...');

    const schema = valid[0].data['$schema'] || 'https://raw.githubusercontent.com/PazerOP/tf2_bot_detector/master/schemas/v3/playerlist.schema.json';
    const authors = new Set();

    // Every archived group name is carried forward here — including groups
    // that arrived indirectly through a previously-exported HROKI file —
    // so re-merging an export later still reports the full lineage of
    // groups, not just the files loaded in this particular merge.
    const archivedGroupSet = new Set();

    valid.forEach(s => {
      const info = s.data.file_info || {};
      (info.authors || []).forEach(a => authors.add(a));
      (s.archivedGroups || [s.name]).forEach(g => archivedGroupSet.add(g));
    });

    const archivedGroups = Array.from(archivedGroupSet);
    log('ARCHIVED GROUPS (' + archivedGroups.length + '): ' + archivedGroups.join(', '));

    // PHASE 2: build the merged player map. Every occurrence of a steamid —
    // whether it's a duplicate across different files or repeated within
    // the same file — has its attributes unioned into one entry, so a
    // player in multiple groups ends up carrying every attribute from
    // every group they appear in (duplicates of the same attribute only
    // count once). Each entry also tracks which group(s) contributed which
    // marks, so duplicates can be logged with their source once every
    // source has been processed.
    const playerMap = new Map(); // steamid -> { attrs: Set, byGroup: Map<groupName, Set<attr>>, hadDuplicate: bool }
    let duplicateCount = 0;

    valid.forEach(s => {
      s.data.players.forEach(p => {
        if (!p || typeof p.steamid !== 'string') return;
        const attrs = applyAttributeChanges(s, Array.isArray(p.attributes) ? p.attributes : []);
        const isDuplicate = playerMap.has(p.steamid);
        if (isDuplicate) duplicateCount += 1;
        let entry = playerMap.get(p.steamid);
        if (!entry) {
          entry = { attrs: new Set(), byGroup: new Map(), hadDuplicate: false };
          playerMap.set(p.steamid, entry);
        }
        if (isDuplicate) entry.hadDuplicate = true;
        attrs.forEach(a => entry.attrs.add(a));
        if (!entry.byGroup.has(s.name)) entry.byGroup.set(s.name, new Set());
        attrs.forEach(a => entry.byGroup.get(s.name).add(a));
      });
    });

    // Log every duplicated steamid as a readable block: one line per
    // contributing group with the marks it brought, then the final
    // combined set of marks for that steamid.
    playerMap.forEach((entry, steamid) => {
      if (!entry.hadDuplicate) return;
      const lines = ['Duplicate SteamID: ' + buildSteamIdLink(steamid)];
      entry.byGroup.forEach((marks, groupName) => {
        lines.push('[' + groupName + '] (' + Array.from(marks).join(', ') + ')');
      });
      lines.push('(' + Array.from(entry.attrs).join(', ') + ')');
      logHtml(lines.join('\n'), 'dim');
    });

    // PHASE 3: verify every steamid from the initial scan made it into the
    // merged map. If anything is missing, recover it from the scan data.
    log('VERIFYING MERGED OUTPUT AGAINST SCAN...');
    let recoveredCount = 0;
    scanned.forEach((attrSet, steamid) => {
      if (!playerMap.has(steamid)) {
        playerMap.set(steamid, { attrs: new Set(attrSet), byGroup: new Map(), hadDuplicate: false });
        recoveredCount += 1;
        logHtml('MISSING ENTRY RECOVERED: ' + buildSteamIdLink(steamid));
      }
    });

    if (recoveredCount > 0) {
      log('INTEGRITY CHECK: ' + recoveredCount + ' missing SteamID(s) restored.');
    } else {
      log('INTEGRITY CHECK PASSED: all scanned steamIDs present.');
    }

    // PHASE 4: "cheater" outranks "suspicious" — if a steamid ended up
    // tagged as both (e.g. suspicious in one group, cheater in another),
    // drop "suspicious" and keep the rest.
    let cheaterOverrideCount = 0;
    playerMap.forEach((entry, steamid) => {
      if (entry.attrs.has('cheater') && entry.attrs.has('suspicious')) {
        entry.attrs.delete('suspicious');
        cheaterOverrideCount += 1;
        logHtml('CHEATER OVERRIDE: ' + buildSteamIdLink(steamid) + ' — "suspicious" removed (also marked "cheater"); remaining: [' +
          Array.from(entry.attrs).join(', ') + ']', 'dim');
      }
    });

    const mergedPlayers = Array.from(playerMap.entries()).map(([steamid, entry]) => ({
      attributes: Array.from(entry.attrs),
      steamid
    }));

    mergedResult = {
      '$schema': schema,
      file_info: {
        authors: Array.from(authors),
        description: 'Merged list — ' + archivedGroups.length + ' source group(s) archived: ' + archivedGroups.join(', '),
        title: 'HROKI merged list (' + archivedGroups.length + ' groups)',
        hroki_archived_groups: archivedGroups
      },
      players: mergedPlayers
    };

    log('MERGE COMPLETE.');
    log('TOTAL UNIQUE STEAMIDS: ' + mergedPlayers.length);
    if (duplicateCount) log('DUPLICATE STEAMIDS RESOLVED: ' + duplicateCount);

    summaryLine.innerHTML = 'MERGE COMPLETE — <strong>' + mergedPlayers.length +
      '</strong> unique SteamIDs from <strong>' + archivedGroups.length + '</strong> archived group(s)' +
      (duplicateCount ? ', <strong>' + duplicateCount + '</strong> duplicate ID(s) resolved' : '') +
      (recoveredCount ? ', <strong>' + recoveredCount + '</strong> SteamID(s) recovered on verify' : '') +
      (cheaterOverrideCount ? ', <strong>' + cheaterOverrideCount + '</strong> "suspicious" tag(s) dropped for cheaters' : '');

    downloadBtn.disabled = false;
  });

  downloadBtn.addEventListener('click', () => {
    if (!mergedResult) return;
    const name = (outName.value || 'HrokiList').trim().replace(/\.json$/i, '') || 'HrokiList';
    const filename = name + '.json';
    const blob = new Blob([JSON.stringify(mergedResult, null, '\t')], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    log('EXPORTED ' + filename + ' TO LOCAL DRIVE.');
  });

  function escapeHtml(str) {
    return str.replace(/[&<>"']/g, c => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    })[c]);
  }
})();
</script>

</body>
</html>
